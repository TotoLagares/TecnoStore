# Copiar este archivo como .env y completar los valores.
# El .env NO se sube al repositorio (está en .gitignore).

# --- Servidor ---
PORT=4000
# Opcional: URL pública del back, para armar los links de las fotos del seed
# (por defecto http://localhost:PORT).
# API_URL=http://localhost:4000
# development | production | test (los tests lo ponen en "test" solos)
NODE_ENV=development

# --- Base de datos ---
MONGO_URI=mongodb://127.0.0.1:27017/tecnostore

# --- Autenticación (JWT) ---
# Poné un string largo y aleatorio. Sin esto no se pueden firmar los tokens.
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=1d

# --- Frontend ---
# Orígenes habilitados para CORS. Se pueden poner varios separados por coma.
CORS_ORIGIN=http://localhost:5173
# URL del frontend: se usa para armar el link del mail de recuperación
# (${FRONTEND_URL}/restablecer-contrasena?token=...).
FRONTEND_URL=http://localhost:5173

# --- Envío de mails (nodemailer) ---
# Si SMTP_HOST queda vacío, en desarrollo se usa una cuenta de prueba de
# Ethereal: los mails NO llegan a destino, pero en la consola del servidor
# aparece una URL para verlos en el navegador.
#
# Para enviar mails reales con Gmail:
#   1. En la cuenta de Google, activar la verificación en 2 pasos
#      (Cuenta de Google > Seguridad).
#   2. Crear una "contraseña de aplicación" en
#      https://myaccount.google.com/apppasswords (son 16 letras).
#   3. Completar:
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=465
#        SMTP_SECURE=true
#        SMTP_USER=tu.cuenta@gmail.com
#        SMTP_PASS=<la contraseña de aplicación, sin espacios>
#        MAIL_FROM=TecnoStore <tu.cuenta@gmail.com>
#   No uses la contraseña normal de la cuenta: Gmail la rechaza.
#   (Alternativa: SMTP_PORT=587 con SMTP_SECURE=false.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente que ve quien recibe el mail. Con Gmail tiene que ser la misma cuenta de SMTP_USER.
MAIL_FROM=TecnoStore <no-reply@tecnostore.com>
# Destinatario de los avisos de nuevas consultas si el comercio no tiene
# email cargado en "Información del comercio".
BUSINESS_EMAIL=
